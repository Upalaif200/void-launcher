{
  "author": "UP",
  "build": {
    "files": [
      "main.js",
      "background.js",
      "skin3d.js",
      "renderer.js",
      "index.html",
      "style.css",
      "package.json",
      "node_modules/**/*",
      "node_modules/three/examples/jsm/**/*",
      "assets/**/*",
      "build/icon.png",
      "build/icon.ico",
      "mod-updater.js",
      "notification-manager.js",
      "p2p-bridge.js",
      "p2p-engine.js",
      "preload.js",
      "server-admin.html",
      "social-db.js",
      "social-manager.js",
      "social-overlay.html",
      "social-overlay.js",
      "social-p2p.js",
      "src/**/*"
    ],
    "nsis": {
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "differentialPackage": true,
      "createStartMenuShortcut": true,
      "allowToChangeInstallationDirectory": false,
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Void-Launcher",
      "oneClick": false
    },
    "electronDist": "node_modules/electron/dist",
    "appId": "com.voidlauncher.app",
    "publish": [
      {
        "owner": "Upalaif200",
        "provider": "github",
        "repo": "void-launcher"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "filter": [
          "keystrokes-1.0.0.jar"
        ],
        "to": "mods/",
        "from": "void-mod/build/libs/"
      }
    ],
    "productName": "Void-Launcher",
    "afterPack": "scripts/after-pack.js",
    "asar": false
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "app-builder-bin": "^4.0.0",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.6.2",
    "minecraft-launcher-core": "^3.18.2",
    "node-datachannel": "^0.32.3",
    "pg": "^8.21.0",
    "simple-peer": "^9.11.1",
    "skinview3d": "^3.4.1"
  },
  "main": "main.js",
  "scripts": {
    "release": "node scripts/release.js",
    "postinstall": "node scripts/generate-icon.js",
    "generate-manifest": "node scripts/generate-manifest.js",
    "build": "electron-builder --win --publish never",
    "start": "electron .",
    "publish": "electron-builder --win --publish always"
  },
  "name": "void-launcher",
  "description": "Launcher creado con el propósito de, aparte de Jugar al Minecraft, jugar con la seguridad de que no hay ningún tipo de Malware.",
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "repository": "Upalaif200/void-launcher",
  "version": "1.4.0"
}
